{
  "headers": [
    {
      "source": "/(.*)\\.(woff2)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(site\\.css|site\\.js|lenis\\.min\\.js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.(png|jpg|svg|webp|webmanifest)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/me.html",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/work-(.*)",
      "destination": "/stuff.html",
      "permanent": false
    }
  ]
}
